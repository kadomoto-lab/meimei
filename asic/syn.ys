# ASAP7 technology mapping of mm_core (no placement): sv2v output -> generic synthesis -> ASAP7 cells
read_verilog mm_small.v
hierarchy -top mm_core
blackbox mm_imem
write_rtlil elab.il
synth -top mm_core -run begin:fine
write_rtlil coarse.il
synth -top mm_core -run fine:check
dfflibmap -liberty asap7_rvt_tt.lib
abc -D 500 -liberty asap7_rvt_tt.lib
opt_clean
hilomap -hicell TIEHIx1_ASAP7_75t_R H -locell TIELOx1_ASAP7_75t_R L
stat -liberty asap7_rvt_tt.lib
write_verilog -noattr -noexpr mm_small_net.v
